# Variables de la aplicación móvil. Copiar como .env y completar.
# El archivo .env se empaqueta con la aplicación y se lee al iniciarla, así
# que queda dentro del APK: no poner aquí contraseñas ni claves secretas.

# URL base de la API REST del backend (en el celular, la IP de la PC o el
# dominio HTTPS del servidor; en el emulador, http://10.0.2.2:8000)
API_URL=http://192.168.1.10:8000

# Dirección de la plataforma web, donde se registran las cuentas
WEB_URL=http://192.168.1.10:5173
